NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical public app URL used for auth email redirects.
# Set this to your deployed host (example: https://banking.example.com)
NEXT_PUBLIC_APP_URL=
# Optional override for auth redirects if different from NEXT_PUBLIC_APP_URL.
AUTH_REDIRECT_BASE_URL=
# Optional legacy fallback (deprecated):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Optional (future provider integration): keep empty while payments run in simulated mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional (dev only): if true, signup falls back to service-role user creation when email rate limit is hit.
AUTH_ALLOW_RATE_LIMIT_SIGNUP_FALLBACK=false
# Optional local storage root for onboarding document files. Defaults to ./uploads/customer-documents
DOCUMENT_UPLOAD_ROOT=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_FULL_NAME=
# Backward compatibility fallback (deprecated):
# SEED_ADMIN_EMAIL=
